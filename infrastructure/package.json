{
  "name": "@yaadon/infrastructure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth -c environment=dev -c region=ap-south-1 -c allowedOrigin=http://localhost:3000",
    "diff": "cdk diff -c environment=dev -c region=ap-south-1 -c allowedOrigin=http://localhost:3000",
    "deploy:dev": "cdk deploy -c environment=dev -c region=ap-south-1 -c allowedOrigin=http://localhost:3000 --require-approval broadening"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1137.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.0"
  }
}
